@model IReadOnlyList<Objeto>
@{ ViewData["Title"] = "Meus objetos"; }
<section class="shell inner-page"><div class="section-heading"><div><span class="eyebrow">PRONTOS PARA UMA NOVA HISTÓRIA</span><h1>Meus objetos</h1><p>O que você coloca pra circular abre espaço para novas possibilidades.</p></div><a class="button button-dark" href="/objetos/novo"><svg class="icon"><use href="#i-mais" /></svg> Cadastrar objeto</a></div>
@if (Model.Count == 0) { <div class="empty-state empty-large"><svg class="icon"><use href="#i-caixa" /></svg><h2>Sua primeira troca começa aqui.</h2><p>Tem um livro, instrumento ou outro objeto que merece ser aproveitado?<br />Cadastre ao menos um objeto disponível para participar das trocas.</p><a class="button button-dark" href="/objetos/novo">Cadastrar meu primeiro objeto</a></div> }
else { <div class="my-object-list">@foreach (var objeto in Model) { <article class="my-object"><a href="/objetos/@objeto.Id"><img src="@Apresentacao.Imagem(objeto)" alt="@objeto.Nome" width="180" height="140" /></a><div class="my-object-copy"><span class="category-label">@objeto.Categoria.Nome · #@objeto.Id</span><h2><a href="/objetos/@objeto.Id">@objeto.Nome</a></h2><p>@Apresentacao.Estado(objeto.EstadoConservacao) <span class="separator">·</span> <span class="status-badge @(objeto.Status == StatusObjeto.DISPONIVEL ? "available" : "")">@(objeto.Status == StatusObjeto.DISPONIVEL ? "Disponível para troca" : objeto.Status == StatusObjeto.TROCADO ? "Já ganhou outro lar" : objeto.Status.ToString())</span></p></div><div class="my-object-actions"><a class="button button-outline button-small" href="/objetos/@objeto.Id/editar"><svg class="icon"><use href="#i-editar" /></svg> Editar</a><form action="/objetos/@objeto.Id/excluir" method="post" asp-antiforgery="true" data-confirm="Excluir este objeto definitivamente? Se ele participa de um match, a exclusão será impedida."><button class="text-button danger" type="submit"><svg class="icon"><use href="#i-lixeira" /></svg> Excluir</button></form></div></article> }</div> }</section>
