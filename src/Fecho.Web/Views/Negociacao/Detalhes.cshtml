@model CartaoMatch
@{ ViewData["Title"] = "Detalhes do match"; var contato = ViewData["Contato"] as ContatoLiberado; }
<section class="shell narrow-page match-detail"><a class="back-link" href="/matches">← Meus matches</a><span class="eyebrow">BOAS TROCAS CONECTAM PESSOAS</span><h1>@Apresentacao.Status(Model.Registro.Status)</h1><p>Você e @Model.OutroObjeto.Proprietario.Nome encontraram uma boa possibilidade.</p><div class="match-pictures"><div><img src="@Apresentacao.Imagem(Model.SeuObjeto)" alt="@Model.SeuObjeto.Nome" width="320" height="250" /><strong>@Model.SeuObjeto.Nome</strong><span>Seu objeto</span></div><span class="swap-circle"><svg class="icon"><use href="#i-troca" /></svg></span><div><img src="@Apresentacao.Imagem(Model.OutroObjeto)" alt="@Model.OutroObjeto.Nome" width="320" height="250" /><strong>@Model.OutroObjeto.Nome</strong><span>Objeto de @Model.OutroObjeto.Proprietario.Nome.Split(' ')[0]</span></div></div>
@if (contato is not null) { <div class="contact-card"><span class="avatar">@contato.Nome[..1]</span><div><span class="eyebrow">CONTATO LIBERADO PARA VOCÊS</span><h2>@contato.Nome</h2><p class="phone-number">@contato.Telefone</p></div><svg class="icon"><use href="#i-check" /></svg></div><p class="privacy-note">Conversem para combinar os detalhes. Prefiram um local público e confiram os objetos antes da entrega.</p> }else { <div class="notice error">O contato não está disponível para este match.</div> }
@if (Model.Registro.Status == StatusMatch.ATIVO) { <form action="/matches/@Model.Registro.Id/concluir" method="post" asp-antiforgery="true" class="form-panel stack-form" data-confirm="Confirmar a troca? Os dois objetos serão marcados como trocados e os matches concorrentes serão cancelados."><h2>Vocês já realizaram a troca?</h2><label for="observacao">Observação <span class="optional">opcional</span></label><textarea id="observacao" name="observacao" rows="3" maxlength="500" placeholder="Ex.: Troca realizada e objetos conferidos."></textarea><button class="button button-dark full-width" type="submit"><svg class="icon"><use href="#i-check" /></svg> Confirmar troca concluída</button></form><form action="/matches/@Model.Registro.Id/cancelar" method="post" asp-antiforgery="true" data-confirm="Cancelar este match? O contato não será mais disponibilizado."><button class="text-button danger cancel-match" type="submit">Não vamos seguir com esta troca</button></form> }
@if (Model.Registro.Status == StatusMatch.CONCLUIDO) { <div class="notice success">Troca registrada em @Model.Registro.DataConclusao?.ToString("dd/MM/yyyy HH:mm") (UTC). Os dois objetos ganharam outro lar.</div>@if (!string.IsNullOrWhiteSpace(Model.Registro.Observacao)) { <div class="tip-box"><span>Como foi a troca</span><p>@Model.Registro.Observacao</p></div> } }</section>
