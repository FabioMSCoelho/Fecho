@model IReadOnlyList<CartaoMatch>
@{ ViewData["Title"] = "Meus matches"; }
<section class="shell inner-page"><div class="section-heading"><div><span class="eyebrow">QUANDO O INTERESSE É RECÍPROCO</span><h1>Deu match. Fechô!</h1><p>Aqui estão as boas trocas que vocês podem combinar.</p></div><a class="button button-outline" href="/">Explorar mais achados <svg class="icon"><use href="#i-seta" /></svg></a></div>@if (Model.Count == 0) { <div class="empty-state empty-large"><svg class="icon"><use href="#i-match" /></svg><h2>O próximo match pode estar pertinho.</h2><p>Quando você curte um objeto e a outra pessoa curte um dos seus,<br />a conexão aparece aqui e o contato é liberado.</p><a class="button button-dark" href="/">Encontrar minha próxima troca</a></div> }else { <div class="matches-grid">@foreach (var match in Model) { <article class="match-card"><span class="status-badge @match.Registro.Status.ToString().ToLowerInvariant()">@Apresentacao.Status(match.Registro.Status)</span><div class="match-pictures"><img src="@Apresentacao.Imagem(match.SeuObjeto)" alt="@match.SeuObjeto.Nome" width="240" height="190" /><span class="swap-circle"><svg class="icon"><use href="#i-troca" /></svg></span><img src="@Apresentacao.Imagem(match.OutroObjeto)" alt="@match.OutroObjeto.Nome" width="240" height="190" /></div><div class="match-copy"><h2>@match.SeuObjeto.Nome <span>↔</span> @match.OutroObjeto.Nome</h2><p>Com @match.OutroObjeto.Proprietario.Nome · @match.Registro.DataMatch.ToString("dd/MM/yyyy")</p><a class="button button-dark full-width" href="/matches/@match.Registro.Id">@(match.Registro.Status == StatusMatch.ATIVO ? "Combinar a troca" : "Ver detalhes") <svg class="icon"><use href="#i-seta" /></svg></a></div></article> }</div> }</section>
