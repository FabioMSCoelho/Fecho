@model PerfilForm
@{ ViewData["Title"] = "Meu perfil"; }
<section class="shell narrow-page"><a href="/" class="back-link">← Voltar a explorar</a><div class="section-heading"><div><span class="eyebrow">DO SEU JEITO</span><h1>Meu perfil</h1><p>Um pouco de você para deixar as trocas mais próximas.</p></div><span class="avatar avatar-large">@(string.IsNullOrEmpty(Model.Nome) ? "?" : Model.Nome[..1])</span></div><form asp-action="Perfil" method="post" class="form-panel stack-form"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Nome">Nome</label><input asp-for="Nome" autocomplete="name" required /><label asp-for="Email">E-mail</label><input asp-for="Email" type="email" autocomplete="email" required /><div class="form-columns"><div><label asp-for="Telefone">Telefone</label><input asp-for="Telefone" autocomplete="tel" required /></div><div><label asp-for="Cidade">Cidade</label><input asp-for="Cidade" autocomplete="address-level2" /></div></div><p class="field-note">Seu telefone fica reservado aos matches dos quais você participa.</p><label asp-for="Descricao">Sobre você</label><textarea asp-for="Descricao" rows="4" maxlength="500" placeholder="Conte um pouco sobre você e o que gosta de trocar."></textarea><div class="form-actions"><button class="button button-dark" type="submit">Salvar alterações <svg class="icon"><use href="#i-check" /></svg></button><a href="/conta/senha" class="subtle-link">Alterar minha senha</a></div></form></section>
