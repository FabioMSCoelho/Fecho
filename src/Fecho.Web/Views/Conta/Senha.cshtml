@model SenhaForm
@{ ViewData["Title"] = "Alterar senha"; }
<section class="shell narrow-page"><a href="/conta/perfil" class="back-link">← Voltar ao meu perfil</a><span class="eyebrow">CUIDANDO DA SUA CONTA</span><h1>Uma nova senha.</h1><p>Após salvar, você precisará entrar novamente. As sessões antigas serão encerradas.</p><form asp-action="Senha" method="post" class="form-panel stack-form"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Atual">Senha atual</label><input asp-for="Atual" autocomplete="current-password" required /><label asp-for="Nova">Nova senha</label><input asp-for="Nova" autocomplete="new-password" minlength="8" maxlength="128" required /><label asp-for="Confirmacao">Confirme a nova senha</label><input asp-for="Confirmacao" autocomplete="new-password" required /><button class="button button-dark" type="submit">Salvar nova senha</button></form></section>
