@model ObjetoDetalhe
@{ ViewData["Title"] = Model.Objeto.Nome; var objeto = Model.Objeto; var proprio = User.FindFirstValue(ClaimTypes.NameIdentifier) == objeto.Proprietario.Id.ToString(); }
<section class="shell detail-page"><a class="back-link" href="/#achados">← Voltar aos achados</a><div class="detail-layout"><div class="detail-image"><img src="@Apresentacao.Imagem(objeto)" alt="@objeto.Nome" width="800" height="650" /></div><div class="detail-copy"><span class="eyebrow">@objeto.Categoria.Nome · OBJETO #@objeto.Id</span><h1>@objeto.Nome</h1><span class="condition-tag in-flow">@Apresentacao.Estado(objeto.EstadoConservacao)</span><p class="detail-description">@(objeto.Descricao ?? "Um objeto pronto para ganhar uma nova história.")</p><div class="owner-block"><span class="avatar">@objeto.Proprietario.Nome[..1]</span><div><strong>@objeto.Proprietario.Nome</strong><p class="location"><svg class="icon"><use href="#i-local" /></svg>@(objeto.Proprietario.Cidade ?? "Cidade não informada")</p></div></div>
@if (objeto.ValorEstimado.HasValue) { <div class="estimate"><span>Valor estimado</span><strong>@objeto.ValorEstimado.Value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong><p>Uma referência para conversar. A troca é entre objetos.</p></div> }
@if (proprio) { <a href="/objetos/@objeto.Id/editar" class="button button-dark full-width">Editar meu objeto <svg class="icon"><use href="#i-editar" /></svg></a> }
else if (objeto.Status != StatusObjeto.DISPONIVEL) { <div class="notice success">Este objeto já está @objeto.Status.ToString().ToLowerInvariant(). Continue explorando outros achados.</div> }
else if (User.Identity?.IsAuthenticated == true) { <form action="/objetos/@objeto.Id/interesse" method="post" asp-antiforgery="true"><input type="hidden" name="retorno" value="/objetos/@objeto.Id" /><button class="button button-dark full-width" name="tipo" value="LIKE"><svg class="icon"><use href="#i-match" /></svg>@(Model.Interesse == TipoInteresse.LIKE ? "Tenho interesse registrado" : "Tenho interesse")</button><button class="button button-outline full-width spaced" name="tipo" value="DISLIKE">@(Model.Interesse == TipoInteresse.LIKE ? "Retirar meu interesse" : "Não é o que procuro")</button></form> }
else { <a class="button button-dark full-width" href="/conta/entrar?returnUrl=/objetos/@objeto.Id">Entrar para demonstrar interesse</a> }
<p class="privacy-note"><svg class="icon"><use href="#i-match" /></svg> O contato só aparece quando o interesse é recíproco. Combine a entrega em um local público.</p></div></div></section>
