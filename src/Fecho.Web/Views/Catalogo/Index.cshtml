@model CatalogoPagina
@{
    ViewData["Title"] = Model.Filtro.Curtidos ? "Seus interesses" : "Descobrir";
    ViewData["Interesses"] = Model.Interesses;
    string Pagina(int numero) => Url.Action("Index", "Catalogo", new { Model.Filtro.Texto, Model.Filtro.CategoriaId, Model.Filtro.Estado,
        Model.Filtro.Cidade, Model.Filtro.ValorMaximo, Model.Filtro.Ordem, Pagina = numero, Model.Filtro.ParaMim, Model.Filtro.Curtidos })!;
}
@if (User.Identity?.IsAuthenticated != true)
{
    <section class="hero shell">
        <div class="hero-copy"><span class="eyebrow"><span class="live-dot"></span> BOAS TROCAS COMEÇAM AQUI</span><h1>O que fica parado<br />pode ganhar <em>história.</em></h1><p>Seu próximo achado pode ser a troca perfeita de alguém.<br class="desktop-only" /> Conecte objetos, pessoas e novas possibilidades.</p>
        <div class="hero-actions"><a href="/conta/cadastrar" class="button button-dark">Começar a trocar <svg class="icon"><use href="#i-seta" /></svg></a><a href="#achados" class="subtle-link">Conhecer os objetos ↓</a></div></div>
        <div class="hero-art" aria-hidden="true"><img asp-append-version="true" src="/arte/circulando.svg" alt="" width="480" height="330" /><span class="floating-note"><svg class="icon"><use href="#i-troca" /></svg> Bom pra você. Bom pra circular.</span></div>
    </section>
}
<section class="shell discovery-page" id="achados">
    <div class="section-heading">
        <div><span class="eyebrow">UMA NOVA HISTÓRIA A CADA ESCOLHA</span><h1>@(Model.Filtro.Curtidos ? "Seus interesses" : "Descobrir")</h1><p>@(Model.Filtro.Curtidos ? "Os objetos que você curtiu ficam guardados aqui." : "Um objeto por vez. Passe ou curta o que combina com você.")</p></div>
        <div class="discovery-heading-links">
            @if (Model.Filtro.Curtidos) { <a class="button button-dark button-small" href="/#achados">Continuar descobrindo <svg class="icon"><use href="#i-seta" /></svg></a> }
            else if (User.Identity?.IsAuthenticated == true) { <a class="subtle-link" href="/?Curtidos=true#achados"><svg class="icon"><use href="#i-match" /></svg> Meus interesses</a> }
        </div>
    </div>
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <div class="discovery-tools">
        <div class="search-field"><svg class="icon"><use href="#i-busca" /></svg><input form="filtros" name="Texto" value="@Model.Filtro.Texto" aria-label="Buscar objetos" maxlength="150" placeholder="O que você procura? Nome, categoria ou código..." /><button form="filtros" type="submit" aria-label="Buscar objetos">Buscar</button></div>
        <label class="sort-label" for="ordem">Ordenar por<select form="filtros" id="ordem" name="Ordem" data-auto-submit><option value="Recentes" selected="@(Model.Filtro.Ordem == OrdemObjetos.Recentes)">Mais recentes</option><option value="Nome" selected="@(Model.Filtro.Ordem == OrdemObjetos.Nome)">Nome: A a Z</option><option value="MenorValor" selected="@(Model.Filtro.Ordem == OrdemObjetos.MenorValor)">Menor estimativa</option><option value="MaiorValor" selected="@(Model.Filtro.Ordem == OrdemObjetos.MaiorValor)">Maior estimativa</option></select></label>
        <details class="discovery-filters">
            <summary><svg class="icon"><use href="#i-filtro" /></svg> Filtros</summary>
            <form id="filtros" method="get" action="/#achados" class="discovery-filter-form" aria-label="Filtros da descoberta">
                <div><label for="categoria">Categoria</label><select id="categoria" name="CategoriaId"><option value="">Todas as categorias</option>@foreach (var c in Model.Categorias) { <option value="@c.Id" selected="@(Model.Filtro.CategoriaId == c.Id)">@c.Nome (@Model.Resultado.QuantidadesPorCategoria.GetValueOrDefault(c.Id))</option> }</select></div>
                <div><label for="estado">Estado de conservação</label><select id="estado" name="Estado"><option value="">Todos os estados</option>@foreach (var estado in Enum.GetValues<EstadoConservacao>()) { <option value="@estado" selected="@(Model.Filtro.Estado == estado)">@Apresentacao.Estado(estado)</option> }</select></div>
                <div><label for="cidade">Cidade</label><input id="cidade" name="Cidade" value="@Model.Filtro.Cidade" maxlength="100" placeholder="Onde você está?" /></div>
                <div><label for="valor">Valor estimado até (R$)</label><input id="valor" name="ValorMaximo" value="@Model.Filtro.ValorMaximo" inputmode="decimal" placeholder="Ex.: 500,00" /></div>
                @if (User.Identity?.IsAuthenticated == true) { <label class="check-line"><input type="checkbox" name="ParaMim" value="true" checked="@Model.Filtro.ParaMim" /> Combina com meus desejos</label> }
                @if (Model.Filtro.Curtidos) { <input type="hidden" name="Curtidos" value="true" /> }
                <div class="discovery-filter-actions"><button class="button button-dark button-small" type="submit">Aplicar filtros</button><a class="clear-link" href="@(Model.Filtro.Curtidos ? "/?Curtidos=true#achados" : "/#achados")">Limpar filtros</a></div>
            </form>
        </details>
    </div>
    @if (Model.Filtro.Curtidos)
    {
        <div class="result-meta"><span><strong>@Model.Resultado.Total</strong> @(Model.Resultado.Total == 1 ? "objeto disponível" : "objetos disponíveis")</span></div>
        @if (Model.Resultado.Itens.Count == 0) { <div class="empty-state"><svg class="icon"><use href="#i-match" /></svg><h2>Seus próximos interesses começam em Descobrir.</h2><p>Curta os objetos que fazem sentido para você. Eles aparecerão aqui.</p><a href="/#achados" class="button button-dark">Descobrir objetos</a></div> }
        else { <div class="object-grid">@foreach (var objeto in Model.Resultado.Itens) { <partial name="_CartaoObjeto" model="objeto" /> }</div> }
        @if (Model.Resultado.TotalPaginas > 1) { <nav class="pagination" aria-label="Páginas dos interesses">@if (Model.Resultado.Pagina > 1) { <a href="@Pagina(Model.Resultado.Pagina - 1)#achados">← Anterior</a> }<span>Página @Model.Resultado.Pagina de @Model.Resultado.TotalPaginas</span>@if (Model.Resultado.Pagina < Model.Resultado.TotalPaginas) { <a href="@Pagina(Model.Resultado.Pagina + 1)#achados">Próxima →</a> }</nav> }
    }
    else
    {
        <div class="discovery-feedback" id="discovery-feedback" role="status" aria-live="polite" aria-atomic="true"></div>
        <partial name="_Descoberta" model="Model" />
        <dialog class="discovery-match" id="discovery-match" aria-labelledby="match-title" aria-describedby="match-description">
            <button class="notice-close match-close" type="button" data-close-match aria-label="Continuar descobrindo">×</button>
            <span class="match-celebration" aria-hidden="true"><svg class="icon"><use href="#i-match" /></svg></span>
            <span class="eyebrow">DUAS ESCOLHAS. UMA BOA TROCA.</span><h2 id="match-title">Deu match. <em>Fechô!</em></h2>
            <p id="match-description">Você e <strong data-match-person></strong> têm interesse mútuo.</p>
            <div class="match-pictures"><div><img data-match-own-image alt="" width="240" height="190" /><strong data-match-own-name></strong><span>Seu objeto</span></div><span class="swap-circle"><svg class="icon"><use href="#i-troca" /></svg></span><div><img data-match-other-image alt="" width="240" height="190" /><strong data-match-other-name></strong><span>Seu próximo achado</span></div></div>
            <p>O contato está liberado nos detalhes do match para vocês combinarem a troca.</p>
            <a class="button button-dark full-width" data-match-link href="/matches">Ver detalhes do match <svg class="icon"><use href="#i-seta" /></svg></a>
            <button class="button button-outline full-width" type="button" data-close-match>Continuar descobrindo</button>
        </dialog>
    }
</section>
@if (User.Identity?.IsAuthenticated != true)
{
    <section class="how-it-works shell" id="como-funciona"><div><span class="eyebrow">BOM PRA TODO MUNDO</span><h2>Uma boa troca.<br />Três passos simples.</h2></div><ol><li><span>01</span><h3>Mostre o que você tem</h3><p>Cadastre aquele objeto em bom estado que pode ganhar outro lar.</p></li><li><span>02</span><h3>Encontre o que combina</h3><p>Veja um objeto por vez e curta o que faz sentido para você.</p></li><li><span>03</span><h3>Deu match? Fechô.</h3><p>O interesse é recíproco? O contato é liberado para vocês combinarem a troca.</p></li></ol></section>
}
@section Scripts {
    @if (!Model.Filtro.Curtidos) { <script src="~/js/descoberta.js" asp-append-version="true" defer></script> }
}
