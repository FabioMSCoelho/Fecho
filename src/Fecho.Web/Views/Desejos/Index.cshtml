@model DesejosPagina
@{ ViewData["Title"] = "Meus desejos"; }
<section class="shell inner-page"><div class="section-heading"><div><span class="eyebrow">O QUE VOCÊ GOSTARIA DE ENCONTRAR?</span><h1>Meus desejos</h1><p>Conte o que procura. A gente aproxima você dos objetos que combinam.</p></div><a class="button button-outline" href="/?ParaMim=true#achados">Ver achados para mim <svg class="icon"><use href="#i-seta" /></svg></a></div><div class="two-columns"><div class="form-panel"><h2>Quero encontrar...</h2><form action="/desejos" method="post" asp-antiforgery="true" class="stack-form"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Form.Descricao">Palavras que descrevem o objeto</label><input asp-for="Form.Descricao" maxlength="255" placeholder="Ex.: violão acústico" required /><label asp-for="Form.CategoriaId">Categoria <span class="optional">opcional</span></label><select asp-for="Form.CategoriaId"><option value="">Qualquer categoria</option>@foreach (var c in Model.Categorias) { <option value="@c.Id">@c.Nome</option> }</select><p class="field-note">A busca procura todas as palavras no nome e na descrição, sem diferenciar maiúsculas ou acentos.</p><button class="button button-dark" type="submit">Adicionar desejo <svg class="icon"><use href="#i-mais" /></svg></button></form></div><div class="wish-list">@if (Model.Desejos.Count == 0) { <div class="empty-state"><svg class="icon"><use href="#i-match" /></svg><h3>Abra espaço para o próximo achado.</h3><p>Adicione seu primeiro desejo. Você pode procurar por mais de um tipo de objeto.</p></div> }@foreach (var desejo in Model.Desejos) { <article class="wish-card"><span class="wish-icon"><svg class="icon"><use href="#i-match" /></svg></span><div><h3>@desejo.Descricao</h3><p>@(desejo.Categoria?.Nome ?? "Qualquer categoria")</p></div><form action="/desejos/@desejo.Id/excluir" method="post" asp-antiforgery="true"><button class="icon-button danger" type="submit" aria-label="Remover desejo @desejo.Descricao"><svg class="icon"><use href="#i-lixeira" /></svg></button></form></article> }</div></div></section>
