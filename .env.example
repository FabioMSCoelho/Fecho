# Somente desenvolvimento local. Copie para .env (ignorado pelo Git) e preencha.
FECHO_DB_HOST=127.0.0.1
FECHO_DB_PORT=3306
FECHO_DB_NAME=fecho
FECHO_DB_USER=fecho
FECHO_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Opcional: senha das três contas fictícias criadas por `bash scripts/fecho.sh seed`.
# Não reutilize senhas pessoais. O comando não altera senhas de contas já existentes.
FECHO_DEMO_PASSWORD=
